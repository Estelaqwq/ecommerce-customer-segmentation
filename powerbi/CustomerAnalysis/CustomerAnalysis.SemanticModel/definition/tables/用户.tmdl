table 用户

	column 用户ID
		dataType: string
		sourceColumn: 用户ID
		summarizeBy: none

	column 年龄
		dataType: int64
		sourceColumn: 年龄
		summarizeBy: none
		formatString: #,0

	column 性别
		dataType: string
		sourceColumn: 性别
		summarizeBy: none

	column 地区
		dataType: string
		sourceColumn: 地区
		summarizeBy: none

	column 用户分层
		dataType: string
		sourceColumn: 用户分层
		summarizeBy: none

	column 累计消费
		dataType: int64
		sourceColumn: 累计消费
		summarizeBy: none
		formatString: #,0

	column 购买频次
		dataType: int64
		sourceColumn: 购买频次
		summarizeBy: none
		formatString: #,0

	column 平均订单金额
		dataType: int64
		sourceColumn: 平均订单金额
		summarizeBy: none
		formatString: #,0

	column 距上次登录天数
		dataType: int64
		sourceColumn: 距上次登录天数
		summarizeBy: none
		formatString: #,0

	column 浏览得分
		dataType: double
		sourceColumn: 浏览得分
		summarizeBy: none
		formatString: 0.00

	column 综合得分
		dataType: double
		sourceColumn: 综合得分
		summarizeBy: none
		formatString: 0.00

	column 邮件订阅
		dataType: string
		sourceColumn: 邮件订阅
		summarizeBy: none

	column 数据口径
		dataType: string
		sourceColumn: 数据口径
		summarizeBy: none

	column 人群类型
		dataType: string
		sourceColumn: 人群类型
		summarizeBy: none
		sortByColumn: 人群排序

	column 消费区间
		dataType: string
		sourceColumn: 消费区间
		summarizeBy: none
		sortByColumn: 消费区间序号

	column 消费区间序号
		dataType: int64
		sourceColumn: 消费区间序号
		summarizeBy: none
		isHidden
		formatString: #,0

	column 登录活跃得分
		dataType: double
		sourceColumn: 登录活跃得分
		summarizeBy: none
		formatString: 0.00

	column 购买频次得分
		dataType: double
		sourceColumn: 购买频次得分
		summarizeBy: none
		formatString: 0.00

	column 累计消费得分
		dataType: double
		sourceColumn: 累计消费得分
		summarizeBy: none
		formatString: 0.00

	column 基础RFM得分
		dataType: double
		sourceColumn: 基础RFM得分
		summarizeBy: none
		formatString: 0.00

	column 分层简称
		dataType: string
		sourceColumn: 分层简称
		summarizeBy: none

	column 人群排序
		dataType: int64
		sourceColumn: 人群排序
		summarizeBy: none
		isHidden
		formatString: #,0

	measure 用户数 = COALESCE(DISTINCTCOUNT('用户'[用户ID]), 0)
		formatString: #,0

	measure 核心用户数 = CALCULATE([用户数], KEEPFILTERS('用户'[人群类型] = "核心用户"))
		formatString: #,0

	measure 潜力用户数 = CALCULATE([用户数], KEEPFILTERS('用户'[人群类型] = "潜力用户"))
		formatString: #,0

	measure 待核对用户数 = CALCULATE([用户数], KEEPFILTERS('用户'[数据口径] = "待核对"))
		formatString: #,0

	measure 平均累计消费 = AVERAGE('用户'[累计消费])
		formatString: #,0.00

	measure 平均购买频次 = AVERAGE('用户'[购买频次])
		formatString: 0.00

	measure 邮件订阅率 = DIVIDE(CALCULATE([用户数], KEEPFILTERS('用户'[邮件订阅] = "已订阅")), [用户数], 0)
		formatString: 0.0%

	measure 登录活跃 = AVERAGE('用户'[登录活跃得分])
		formatString: 0.0

	measure 浏览行为 = AVERAGE('用户'[浏览得分])
		formatString: 0.0

	measure 平均登录间隔 = AVERAGE('用户'[距上次登录天数])
		formatString: 0.0

	measure 测算客单价 = 104.039
		formatString: 0.000

	measure 假设毛利率 = 0.40
		formatString: 0%

	measure 假设券额 = 10
		formatString: 0.00

	measure 假设联系成本 = 0.5
		formatString: 0.00

	measure 假设自然购买率 = 0.01
		formatString: 0%

	measure 预计增量净收益 = [潜力用户数] * ((SELECTEDVALUE('收益情景'[假设购买率]) - [假设自然购买率]) * [测算客单价] * [假设毛利率] - SELECTEDVALUE('收益情景'[假设购买率]) * [假设券额] - [假设联系成本])
		formatString: #,0.00;-#,0.00;0.00

	measure 预计营销成本 = [潜力用户数] * (SELECTEDVALUE('收益情景'[假设购买率]) * [假设券额] + [假设联系成本])
		formatString: #,0.00

	measure 平均频次得分 = AVERAGE('用户'[购买频次得分])
		formatString: 0.0

	measure 平均消费得分 = AVERAGE('用户'[累计消费得分])
		formatString: 0.0

	measure 平均RFM得分 = AVERAGE('用户'[基础RFM得分])
		formatString: 0.0

	measure 平均综合得分 = AVERAGE('用户'[综合得分])
		formatString: 0.0

	measure 用户总数显示 = FORMAT([用户数], "#,0")

	measure 核心用户显示 = FORMAT([核心用户数], "#,0")

	measure 潜力用户显示 = FORMAT([潜力用户数], "#,0")

	measure 平均累计消费显示 = FORMAT([平均累计消费], "#,0.00")

	measure 邮件订阅率显示 = FORMAT([邮件订阅率], "0.0%")

	measure 待核对用户显示 = FORMAT([待核对用户数], "#,0")

	partition 用户 = m
		mode: import
		source =
				let
				    Source = Csv.Document(Binary.Decompress(Binary.FromText("", BinaryEncoding.Base64), Compression.Deflate), [Delimiter=",", Columns=22, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Headers, {{"用户ID", type text}, {"年龄", Int64.Type}, {"性别", type text}, {"地区", type text}, {"用户分层", type text}, {"累计消费", Int64.Type}, {"购买频次", Int64.Type}, {"平均订单金额", Int64.Type}, {"距上次登录天数", Int64.Type}, {"浏览得分", type number}, {"综合得分", type number}, {"邮件订阅", type text}, {"数据口径", type text}, {"人群类型", type text}, {"消费区间", type text}, {"消费区间序号", Int64.Type}, {"登录活跃得分", type number}, {"购买频次得分", type number}, {"累计消费得分", type number}, {"基础RFM得分", type number}, {"分层简称", type text}, {"人群排序", Int64.Type}})
				in
				    Typed

	annotation PBI_ResultType = Table
