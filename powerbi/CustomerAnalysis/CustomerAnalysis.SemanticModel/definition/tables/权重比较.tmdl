				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Headers, {{"浏览权重", type number}, {"名单重合率", type number}, {"替换人数", Int64.Type}, {"入选人数", Int64.Type}, {"平均累计消费", type number}, {"平均浏览得分", type number}})
