table 收益情景

	column 假设购买率
		dataType: double
		sourceColumn: 假设购买率
		summarizeBy: none
		formatString: 0%

	column 情景
		dataType: string
		sourceColumn: 情景
		summarizeBy: none

	partition 收益情景 = m
		mode: import
		source =
				let
				    Source = Csv.Document(Binary.Decompress(Binary.FromText("e9rY/mLdvhdb1j7ZueF5X7vOs+bWZzPX83IZ6BkY6bzY1/xkb9+z/glPe9vBQqY6T3asfb62EyEEVvRy9QyYCAA=", BinaryEncoding.Base64), Compression.Deflate), [Delimiter=",", Columns=2, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Headers, {{"假设购买率", type number}, {"情景", type text}})
				in
				    Typed

	annotation PBI_ResultType = Table
