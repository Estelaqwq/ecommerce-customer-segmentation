{
  "name": "AcademicBlueWhite",
  "dataColors": [
    "#174A8B",
    "#4D91D5",
    "#B3CBE6",
    "#7893B5",
    "#6CB5DB"
  ],
  "background": "#FFFFFF",
  "foreground": "#173457",
  "tableAccent": "#225AA7",
  "textClasses": {
    "title": {
      "fontFace": "Microsoft YaHei",
      "fontSize": 13,
      "color": "#173457"
    },
    "label": {
      "fontFace": "Microsoft YaHei",
      "fontSize": 10,
      "color": "#586D83"
    },
    "callout": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 30,
      "color": "#174A8B"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "subTitle": [
          {
            "show": false
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ],
        "border": [
          {
            "show": true,
            "radius": 0,
            "color": {
              "solid": {
                "color": "#D9E3EF"
              }
            }
          }
        ]
      }
    }
  }
}