table 权重比较

	column 浏览权重
		dataType: double
		sourceColumn: 浏览权重
		summarizeBy: none
		formatString: 0%

	column 名单重合率
		dataType: double
		sourceColumn: 名单重合率
		summarizeBy: none
		formatString: 0.0%

	column 替换人数
		dataType: int64
		sourceColumn: 替换人数
		summarizeBy: none
		formatString: #,0

	column 入选人数
		dataType: int64
		sourceColumn: 入选人数
		summarizeBy: none
		formatString: #,0

	column 平均累计消费
		dataType: double
		sourceColumn: 平均累计消费
		summarizeBy: none
		formatString: 0.00

	column 平均浏览得分
		dataType: double
		sourceColumn: 平均浏览得分
		summarizeBy: none
		formatString: 0.00

	measure 名单重合比例 = MAX('权重比较'[名单重合率])
		formatString: 0.0%

	measure 更换人数 = MAX('权重比较'[替换人数])
		formatString: #,0

	measure 入选平均消费 = MAX('权重比较'[平均累计消费])
		formatString: #,0.00

	measure 入选平均浏览得分 = MAX('权重比较'[平均浏览得分])
		formatString: 0.00

